# ==========================================
# VERCEL FRONTEND CONFIGURATION (Client-Safe)
# ==========================================
# In production, point this to your Render backend API (e.g. https://api.kilifasuites.com/api or https://kilifa-api.onrender.com/api)
VITE_API_URL=

# ==========================================
# RENDER BACKEND CONFIGURATION (Server-Only Secrets)
# ==========================================
NODE_ENV=production
PORT=3000
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://kilifasuites.com,https://www.kilifasuites.com
APP_URL=https://kilifasuites.com
ALLOW_MEMORY_FALLBACK=false

# Optional Integrations
AFRIMONEY_API_KEY=
AFRIMONEY_MERCHANT_CODE=
APS_MERCHANT_ID=
APS_WALLET_API_KEY=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
GEMINI_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=
RESEND_API_KEY=
SENDGRID_API_KEY=
STRIPE_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VISA_GATEWAY_API_KEY=
WAVE_API_KEY=
WAVE_MERCHANT_ID=
WAVE_WEBHOOK_SECRET=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=