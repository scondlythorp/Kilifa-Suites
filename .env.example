# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN="*"

# PostgreSQL Database Connection String (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kilifa_suites?schema=public"

# Persistence Policy: In production, enforce 'false' so database errors are never masked by RAM storage
ALLOW_MEMORY_FALLBACK="false"

# JWT Authentication Configuration (Required: Provide a strong 64+ char random key in production)
JWT_SECRET=""
JWT_EXPIRES_IN="24h"

# Payment Gateway Credentials (Optional - abstraction layer automatically falls back to clean simulation when merchant keys are omitted)
# Wave Mobile Money
WAVE_API_KEY=""
WAVE_MERCHANT_ID=""
WAVE_WEBHOOK_SECRET=""

# Afrimoney Mobile Money (The Gambia)
AFRIMONEY_API_KEY=""
AFRIMONEY_MERCHANT_CODE=""

# APS Wallet (Gambia)
APS_WALLET_API_KEY=""
APS_MERCHANT_ID=""

# Visa / Card Processing (Stripe or Direct Processor)
VISA_GATEWAY_API_KEY=""
STRIPE_SECRET_KEY=""

# PayPal Integration
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"

# Notification Provider Credentials (Optional - abstraction layer automatically falls back to clean simulation when keys are omitted)
# Email Provider (Resend / SendGrid / SMTP)
EMAIL_API_KEY=""
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_FROM_ADDRESS="reservations@kilifasuites.com"

# WhatsApp Business API / Twilio WhatsApp
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""

# SMS Gateway (Twilio / Africastalking / Gambia SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

